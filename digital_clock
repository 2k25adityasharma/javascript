<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Clock</title>
    <link rel="stylesheet" href="style.css">
</head>
<style>
    *{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;

    background:#222;
    color:white;

    font-family:Arial;
}

.clock{

    text-align:center;

    padding:40px;

    border-radius:15px;

    background:#333;

}

#time{

    font-size:60px;

    margin:20px 0;
}

#date{

    font-size:25px;
}
</style>
<body>


    <div class="clock">
    
        <h1>Digital Clock</h1>

        <h2 id="time">00:00:00</h2>

        <p id="date">Loading...</p>
   <button id ="change">12-Hour ↔ 24-Hour</button>
    </div>
</body>
<script>
  const time = document.getElementById("time");
const date = document.getElementById("date");
const change = document.getElementById("change")
let is12 = true;

 change.addEventListener("click",function(){
    is12=!is12;
 })



function showTime(){

    const now = new Date();

    let hour = now.getHours();
    let minute = now.getMinutes();
    let second = now.getSeconds();

 if (hour < 10)
    hour = "0" + hour;

if (minute < 10)
    minute = "0" + minute;

if (second < 10)
    second = "0" + second;

    
    let ampm = "";
    if(is12){
    ampm="AM"
    if(hour >= 12){
        ampm = "PM";
    }

    if(hour > 12){
        hour = hour - 12;
    }

    if(hour == 0){
        hour = 12;
    }

    }
    else{
        change.innerText="24-Hour ↔ 12-Hour"
       
    }
    
   

    time.innerText = `${hour}:${minute}:${second} ${ampm}`;

    date.innerText = now.toDateString();
}


showTime()
setInterval(showTime,1000);


</script>
</html>
